{
    "rewrites": [
        {
            "source": "/:path((?!api/|assets/|.*\\..*).*)",
            "has": [{ "type": "host", "value": "admin.juca.uz" }],
            "destination": "/admin.html"
        },
        { "source": "/maqola/:slug", "destination": "/api/article/:slug" },
        { "source": "/maqola/:slug/", "destination": "/api/article/:slug" }
    ],
    "redirects": [
        {
            "source": "/admin",
            "destination": "/admin.html",
            "permanent": false
        },
        {
            "source": "/admin.html",
            "has": [{ "type": "host", "value": "juca.uz" }],
            "destination": "https://admin.juca.uz/",
            "permanent": false
        },
        {
            "source": "/admin.html",
            "has": [{ "type": "host", "value": "www.juca.uz" }],
            "destination": "https://admin.juca.uz/",
            "permanent": false
        }
    ]
}
